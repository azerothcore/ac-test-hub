# Build-time opt-in. Leave false for the default static / GitHub Pages deployment.
VITE_TC9_ENABLED=false

# Runtime gateway settings. Use your provider's HTTPS origin and a dedicated token.
# Never put secrets in VITE_* variables: they are included in public JavaScript.
TC9_UPSTREAM_URL=https://provisioner.example.org
TC9_API_TOKEN=
TC9_PUBLIC_ORIGIN=https://hub.example.org
# Match the browser-visible path; use /test-hub/tc9-api/ for a /test-hub/ install.
TC9_COOKIE_PATH=/tc9-api/
PORT=8787

# All visitors share the token. Lifecycle controls are disabled by default.
TC9_ALLOW_MANAGEMENT=false
# Optional provider extension: anonymous, separate in-game accounts per visitor/realm.
TC9_PERSONAL_ACCOUNTS=false
# Required when personal accounts are enabled. Generate once: openssl rand -hex 32
# Retain across gateway restarts and API token rotation.
TC9_VISITOR_SECRET=
